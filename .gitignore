# ─────────────────────────────────────────────────────────────
# Jordan Economic Pulse: .gitignore
# ─────────────────────────────────────────────────────────────

# ── Power BI local state (machine-specific; regenerated by Desktop) ──
**/.pbi/
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
*.pbix
*.pbix.bak
*.pbit
*.pbids
**/*.abf
**/TabularEditor/
~$*

# ── Data: raw official downloads and regenerable staging are not committed ──
# Re-create raw files from data/SOURCES.csv (official URLs + SHA-256).
data/raw/*
!data/raw/README.md
data/staging/
*.parquet
*.duckdb
*.duckdb.wal

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pbi_venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Secrets and credentials (never commit) ──
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
secrets.*
credentials*.json
*token*.txt
*.kdbx

# ── Logs, dumps and temporary files ──
*.log
*.dmp
*.mdmp
SQLDUMPER_ERRORLOG.log
*.tmp
*.temp
*.bak
*.swp
*~
_scratch/
scratch/
tmp/

# ── Editors and IDEs ──
.vscode/
.idea/
*.code-workspace
.cursor/
.claude/
.antigravity/

# ── Operating system ──
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
